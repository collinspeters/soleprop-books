# Receipt Processing Configuration
# Copy these settings to your .env file and configure as needed

# Enable/disable asynchronous processing (requires queue workers)
RECEIPT_ASYNC_PROCESSING=true

# File upload settings
RECEIPT_MAX_SIZE=10240  # Maximum file size in KB (10MB)
RECEIPT_STORAGE_DISK=local  # Storage disk for receipt files

# Transaction matching settings
RECEIPT_DATE_TOLERANCE=5  # Days tolerance for date matching
RECEIPT_MIN_MATCH_SCORE=0.7  # Minimum score for fuzzy matching
RECEIPT_AUTO_MATCH_THRESHOLD=0.8  # Threshold for automatic matching

# AI categorization settings
RECEIPT_AI_ENABLED=true
RECEIPT_AI_FALLBACK=true  # Fallback to rule-based categorization
RECEIPT_AI_CONFIDENCE_THRESHOLD=0.6

# OCR Service Configuration (OCR.space)
# Get your free API key from https://ocr.space/ocrapi
OCR_API_URL=https://api.ocr.space/parse/image
OCR_API_KEY=your_ocr_api_key_here

# OpenAI Configuration for AI categorization
# Get your API key from https://platform.openai.com/
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Queue Configuration (required for async processing)
QUEUE_CONNECTION=database  # or redis, sync for immediate processing